{
  "name": "rss-feed",
  "type": "module",
  "version": "0.1.1",
  "private": true,
  "description": "RSS Feed",
  "author": "kaho",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "esno gen_data.ts && vite build",
    "build:web": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "postinstall": "npx simple-git-hooks"
  },
  "dependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@extractus/feed-extractor": "^7.1.7",
    "@vueuse/core": "^14.2.1",
    "date-fns": "^4.1.0",
    "esno": "^4.8.0",
    "fuse.js": "^7.1.0",
    "got": "^14.6.6",
    "p-limit": "^7.3.0",
    "pangu": "^7.2.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@cloudflare/kv-asset-handler": "^0.4.2",
    "@iconify-json/carbon": "^1.2.19",
    "@types/node": "^25.5.0",
    "@types/pangu": "^4.0.2",
    "@unocss/eslint-config": "^66.6.6",
    "@unocss/reset": "^66.6.6",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.3",
    "jsdom": "^29.0.0",
    "lint-staged": "^16.4.0",
    "naive-ui": "^2.44.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "unocss": "^66.6.6",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.2.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm typecheck"
  },
  "lint-staged": {
    "src/**/*.{js,cjs,mjs,ts,cts,mts,vue}": [
      "eslint --fix"
    ],
    "package.json": [
      "eslint --fix"
    ]
  }
}
